# DepGate — Environment Variables
# Copy this file to .env and adjust values as needed.

# ── Backend Server ──
PORT=3050
HOST=0.0.0.0
NODE_ENV=development

# ── HTTPS and network (production: see deploy/README.md) ──
# Serve HTTPS on TLS_PORT with these PEM files (full chain, unencrypted key); PORT then only redirects.
# Unset, or DISABLE_SSL=true: plain HTTP on PORT (TLS on your own proxy).
# TLS_CERT_FILE=/certs/tls.crt
# TLS_KEY_FILE=/certs/tls.key
# TLS_PORT=8443
# HTTP_REDIRECT=true
# DISABLE_SSL=false
# false when clients connect directly; number of proxies in front otherwise. Default true.
# TRUST_PROXY=1
# Private port for /metrics, /healthz, /readyz. When set, /metrics leaves the main port.
# MANAGEMENT_PORT=9464

# ── Logging ──
# Options: debug, info, warn, error
LOG_LEVEL=info
# Write allowed package downloads to the decision ledger. Default: off.
# Blocks are always recorded. true, 1, yes, and on enable it.
# AUDIT_LOG_ALLOWS=false

# ── PostgreSQL ──
# Can point to an external/managed database
DB_HOST=localhost
DB_PORT=5432
DB_USER=depgate
DB_PASSWORD=depgate
DB_NAME=depgate
DB_SSL=false
# Verify the database server certificate against this CA (otherwise SSL only encrypts).
# DB_SSL_CA_FILE=/certs/db-ca.crt

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Gateway (npm metadata rewrite) ──
# Base URL clients use to reach the gateway (for rewritten tarball URLs)
GATEWAY_URL=http://localhost:3050
# Where the web UI is served: the Package check link in 403 responses, and links in invitation and password reset emails.
# Optional. Without it, email links use the address a signed-in Security admin used; otherwise GATEWAY_URL.
# UI_URL=https://depgate.example.com
# Documentation site linked from the sidebar's Help section. Point it at an internal copy, or leave it unset to hide the link.
DOCS_URL=https://github.com/secmods/depgate/
# Registry auth is always enabled for package endpoints.
# Fresh window for npm packuments, in seconds (default 300 = 5 min).
# After this, a stale copy is served while one request refreshes it.
NPM_METADATA_TTL=300
# How long a stale npm packument may still be served, in seconds (default 3600).
# Keep this greater than NPM_METADATA_TTL.
NPM_METADATA_STALE_TTL=3600
# Negative cache TTL for npm 404s in seconds (default 60)
NPM_NEGATIVE_TTL=60
# Fresh window for other ecosystem metadata (PyPI, Maven, Go, NuGet, Cargo, Composer, RubyGems).
# Defaults to NPM_METADATA_TTL when unset.
METADATA_TTL=300
# Stale window for that metadata. Defaults to NPM_METADATA_STALE_TTL when unset.
METADATA_STALE_TTL=3600
# Negative cache TTL for other ecosystem 404s. Defaults to NPM_NEGATIVE_TTL when unset.
METADATA_NEGATIVE_TTL=60
# Redis lock so a hot cache miss is fetched upstream once across replicas, in seconds (default 30).
# The holder renews it while the fetch runs.
CACHE_LOCK_TTL=30
# How long a request waits for another replica's fetch before fetching itself, in milliseconds (default 60000)
CACHE_WAIT_MAX_MS=60000
# How long an upstream failure is remembered so concurrent requests fail fast, in seconds (default 5)
CACHE_ERROR_TTL=5
# Per-process memory for parsed npm packuments and filtered responses, in megabytes (default 128, 0 disables)
NPM_MEMORY_CACHE_MB=128
# Version license and publish time, in seconds (default 86400).
# Vulnerability lists follow OSV_CACHE_TTL so a new CVE is enforced within that window.
FACTS_CACHE_TTL=86400
# deps.dev backup for a missing publish time or SPDX license on a public upstream.
# Composer is not covered. Set DEPS_DEV_ENABLED=false to skip the lookup.
DEPS_DEV_ENABLED=true
DEPS_DEV_API_URL=https://api.deps.dev
DEPS_DEV_TIMEOUT_MS=3000
DEPS_DEV_NEGATIVE_TTL=60
# Policies, gateway settings, webhooks and repositories are reloaded at least this often, in milliseconds (default 60000)
REFERENCE_MAX_AGE_MS=60000

# ── Artifact cache (package files from public registries, on each replica's local disk) ──
# Off by default. deploy/docker-compose.yml turns it on with a named volume. With ARTIFACT_CACHE_MAX_SIZE_GB set,
# Settings > Artifact cache can also switch it on or off, which overrides this value.
# ARTIFACT_CACHE_ENABLED=false
# Local SSD, one directory per replica. Never share it between replicas (no NFS, no ReadWriteMany).
# ARTIFACT_CACHE_DIR=/var/lib/depgate/artifacts
# Required when enabled: the most disk the cache uses on each replica, in GB (1024^3 bytes).
# Keep it below the volume size. DepGate does not start when the cache is on without it.
# ARTIFACT_CACHE_MAX_SIZE_GB=80
# Most files per replica (default 200000).
# ARTIFACT_CACHE_MAX_FILES=200000
# A stored file is downloaded again after this many days (default 30, 0 = never).
# ARTIFACT_CACHE_MAX_AGE_DAYS=30
# A file nobody downloaded for this many days is removed (default 7, 0 = never).
# ARTIFACT_CACHE_MAX_IDLE_DAYS=7
# Larger files are served but not stored, in megabytes (default 1024).
# ARTIFACT_CACHE_MAX_FILE_MB=1024

# ── OpenSSF Scorecard (Project health rule) ──
# SCORECARD_ENABLED=true
# SCORECARD_API_URL=https://api.securityscorecards.dev
# SCORECARD_CACHE_TTL=86400
# SCORECARD_NEGATIVE_TTL=3600
# SCORECARD_TIMEOUT_MS=3000

# ── EPSS (exploit likelihood in the Vulnerability rule) ──
# Downloaded once a day by the epss-sync job into the database; requests never call FIRST.
# EPSS_ENABLED=true
# EPSS_FEED_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# Backup when the feed cannot be read: one folder per year; {year} and {date} (UTC) are filled in. Empty disables it.
# EPSS_BACKUP_URL_TEMPLATE=https://raw.githubusercontent.com/empiricalsec/epss_scores/main/{year}/epss_scores-{date}.csv.gz
# EPSS_BACKUP_DAYS=3
# EPSS_SYNC_INTERVAL_HOURS=24
# EPSS_FEED_TIMEOUT_MS=300000
# EPSS_STALE_AFTER_HOURS=72

# ── OSV (CVE lookup) ──
OSV_API_URL=https://api.osv.dev
# Cached single-version query results, in seconds (default 3600)
OSV_CACHE_TTL=3600
# Cached vulnerability documents used for severity, in seconds (default 86400)
OSV_VULN_CACHE_TTL=86400
# Batch query and severity fetch timeout, in milliseconds (default 3000)
OSV_TIMEOUT_MS=3000
# Single-version query timeout used by simulation, in milliseconds (default 15000)
OSV_QUERY_TIMEOUT_MS=15000

# ── Outbound timeouts ──
# How long each address of a registry host gets to connect before the next is tried, in milliseconds (default 2500).
# Node's own 250 ms fails under congested egress when the host also lists IPv6 addresses the network cannot reach.
UPSTREAM_CONNECT_ATTEMPT_TIMEOUT_MS=2500
# Webhook delivery timeout, in milliseconds (default 10000)
WEBHOOK_TIMEOUT_MS=10000
# Malicious-package feed download timeout, in milliseconds (default 300000)
MALICIOUS_FEED_TIMEOUT_MS=300000
# A remote's circuit opens when, within 10 seconds, at least 5 requests failed and they are at least half of its requests.
# How long an open circuit stays open before one trial request, in milliseconds (default 10000)
CIRCUIT_BREAKER_RESET_MS=10000

# ── Malicious packages feed (secmods/malicious-packages) ──
# Incremental sync reads manifest.json and *.changes.jsonl from this root.
# MALICIOUS_FEED_URL=https://github.com/secmods/malicious-packages/raw/refs/heads/main/malicious-packages
# Full loads download this release archive.
# MALICIOUS_FEED_ARCHIVE_URL=https://github.com/secmods/malicious-packages/releases/latest/download/malicious-packages.tar.gz
# How often the malware feed syncs, in hours (default 1). 0 disables the schedule.
MALICIOUS_SYNC_INTERVAL_HOURS=1
# Limit per ecosystem for local (e.g. 10). Omit for production (sync all).
# MALICIOUS_SYNC_LIMIT_PER_ECOSYSTEM=10

# ── Monitor mode ──
# Versions a monitoring policy recorded but nobody downloaded for this many days drop out of the report. 0 keeps them.
MONITOR_RETENTION_DAYS=90
# Rows kept per monitoring policy (default 50000). Beyond it new versions are counted, not stored.
# MONITOR_MAX_ROWS_PER_POLICY=50000
# How often the retention purge runs, in minutes (default 60).
# MONITOR_PURGE_INTERVAL_MINUTES=60

# ── Auth ──
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# Browser session lifetime. The token copied into a package client is separate.
# Security sets that registry token under Settings. It defaults to 30 days.
UI_SESSION_EXPIRES_IN=1h
ADMIN_EMAIL=admin@depgate.local
ADMIN_PASSWORD=admin
# INVITE_EXPIRY_HOURS=168
# PASSWORD_RESET_EXPIRY_MINUTES=60
# Failed password sign-ins per 15 minutes before /api/auth/login answers 429 (0 = no limit). Successes never count.
# LOGIN_FAILURE_LIMIT_PER_EMAIL=10
# LOGIN_FAILURE_LIMIT_PER_IP=100
# Failed sign-ins written to the Decision Ledger per IP per minute; the rest are only counted.
# LOGIN_FAILURE_AUDIT_PER_MINUTE=20
# Single sign-on is configured in Settings → Single sign-on, not here. These only tune it:
# requests per IP per 10 minutes to each SSO endpoint (0 = no limit)
# SSO_RATE_LIMIT=600
# Accept plain-http identity providers on hosts other than localhost / *.localhost. Test setups only.
# SSO_ALLOW_INSECURE_HTTP=false

# ── Email (invitations and password reset) ──
# Optional here: Security can also set this under Settings > Email, which overrides these.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DepGate <no-reply@example.com>
