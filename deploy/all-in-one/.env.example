# DepGate all-in-one settings: Postgres, Redis and DepGate on this host. ./1-configure.sh writes .env
# from this file with generated passwords, or: cp .env.example .env && chmod 600 .env

# ── Image ───────────────────────────────────────────────────────────────────
# Pulled, never built. DEPGATE_VERSION is stamped by the release; the README explains upgrades.
# From Docker Hub; the same image is also ghcr.io/secmods/depgate. Point DEPGATE_IMAGE at your internal
# mirror if hosts have no internet.
DEPGATE_IMAGE=secmods/depgate
DEPGATE_VERSION=1.0.2

# ── Required ────────────────────────────────────────────────────────────────
# The address users and package clients use. Registry responses contain links built from it.
GATEWAY_URL=https://depgate.example.com
# openssl rand -hex 32. Keep it: a new value signs everyone out and breaks every registry token.
JWT_SECRET=
# First admin account, used only when DepGate first starts on an empty database. Changing it
# later does nothing; change the password in the web UI instead. Both may be removed afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Bundled Postgres and Redis ──────────────────────────────────────────────
# The only connection settings: host, port, user and database are fixed in docker-compose.yml.
# Hex only (openssl rand -hex 24): REDIS_PASSWORD sits inside a URL.
DB_PASSWORD=
REDIS_PASSWORD=
# Redis memory for the metadata cache and job queues. See the Sizing table in the documentation.
# REDIS_MAXMEMORY=2gb
# Images, for hosts that mirror them. Pinned to exact releases in docker-compose.yml.
# POSTGRES_IMAGE=postgres:17.11-alpine
# REDIS_IMAGE=redis:7.4.11-alpine

# ── HTTPS ───────────────────────────────────────────────────────────────────
# false (default): DepGate serves HTTPS on 443 and redirects 80 to it.
# true: plain HTTP only, on port 80; nothing answers on 443 and no certificate is needed.
#       Your own proxy or load balancer terminates TLS and forwards to DepGate.
#       GATEWAY_URL stays the https:// address users reach through that proxy.
DISABLE_SSL=false
#
# With HTTPS in DepGate, ./certs holds exactly three files:
#   tls.crt  the certificate, full chain: server certificate first, then intermediates.
#            It must name the host in GATEWAY_URL.
#   tls.key  its private key, unencrypted.
#   ca.crt   your CA certificate (public). Clients trust it; DepGate trusts it for outgoing TLS.
# Never put a CA's private key there. A renewed certificate is picked up within a minute, without a restart.
# HTTPS_PORT=443
# Docker still reserves host port 443 with DISABLE_SSL=true. If your proxy on this host needs it:
# HTTPS_PORT=127.0.0.1:8443
#
# Host port for HTTP: the redirect with HTTPS, or the whole app with DISABLE_SSL=true.
# HTTP_PORT=80
# With DISABLE_SSL=true and the proxy on this same host, keep DepGate off the network:
# HTTP_BIND=127.0.0.1
# Proxies in front of DepGate whose X-Forwarded-For is believed for client IPs.
# Default: 1 with DISABLE_SSL=true, false with HTTPS in DepGate.
# TRUST_PROXY=1

# ── Corporate network ───────────────────────────────────────────────────────
# DepGate fetches packages from npmjs, PyPI and the rest, and reads OSV, deps.dev and the
# malicious-package feed on GitHub. Through an outbound HTTP proxy:
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,.internal.example.com
#
# certs/ca.crt is trusted for every outgoing TLS connection (internal registries, a TLS-inspecting
# proxy). If several CAs are involved, put them all in ca.crt (PEM, one after another).
# NODE_EXTRA_CA_CERTS=/certs/ca.crt

# ── Email (optional; can also be set in Settings > Email) ───────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DepGate <no-reply@example.com>

# ── Artifact cache ──────────────────────────────────────────────────────────
# Package files from public registries are kept in the artifact-cache volume, so repeat installs
# run at disk speed and keep working while a registry is down. docker-compose.yml turns it on;
# Settings > Artifact cache switches it off or on without a restart.
# Required: the most disk it may use, in GB. Keep it below the free space of the Docker volume disk.
ARTIFACT_CACHE_MAX_SIZE_GB=50
# ARTIFACT_CACHE_MAX_FILES=200000
# Download a stored file again after this many days (0 = never), and remove files unused this long.
# ARTIFACT_CACHE_MAX_AGE_DAYS=30
# ARTIFACT_CACHE_MAX_IDLE_DAYS=7
# Larger files are served but not stored.
# ARTIFACT_CACHE_MAX_FILE_MB=1024

# ── Other ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Background jobs this instance runs: all (default), none, or a list such as webhooks,email.
# WORKERS=all
# Documentation site linked from the sidebar's Help section. Without internet access, point it at
# an internal copy, or leave it unset to hide the link.
DOCS_URL=https://github.com/secmods/depgate/
# Every other variable in the Configuration reference (cache TTLs, timeouts, feed settings) can be added here as well.
