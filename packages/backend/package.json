{
  "name": "@depgate/backend",
  "version": "1.0.3",
  "private": true,
  "description": "EDG Fastify backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --run --exclude **/*.integration.test.ts",
    "test:integration": "RUN_INTEGRATION=1 vitest run --run --maxWorkers=1 src/**/*.integration.test.ts",
    "test:integration:registry-auth": "RUN_INTEGRATION=1 vitest run --run src/routes/npm-registry-auth.integration.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src/ scripts/",
    "openapi": "tsx src/write-openapi.ts",
    "migration:new": "tsx scripts/migration-new.ts",
    "migration:draft": "tsx scripts/migration-draft.ts",
    "migration:check": "bash scripts/migration-history.sh",
    "db:adopt": "tsx scripts/db-adopt.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-saml/node-saml": "5.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "ae-cvss-calculator": "^1.0.13",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.16",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "minimatch": "^10.2.6",
    "nodemailer": "^10.1.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "xml-crypto": "^6.4.0",
    "xml-encryption": "^6.0.2"
  }
}
